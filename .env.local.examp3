# HARIS local environment template
# Never commit real credentials. Copy to .env.local and fill locally.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

HARIS_ORCHESTRATOR_MODEL=anthropic:claude-sonnet
HARIS_ANALYZER_MODEL=anthropic:claude-opus
HARIS_QUICK_MODEL=anthropic:claude-sonnet
HARIS_VISION_MODEL=anthropic:claude-opus
HARIS_EMBEDDING_MODEL=openai:text-embedding-3-large
HARIS_DEFAULT_MODEL=openai:gpt-4o-mini
HARIS_ADVERSARIAL_MODEL=anthropic:claude-opus

YGT_SCRAPER_ENABLED=false
CRON_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

HARIS_TRIAL_DAYS=14
HARIS_DEFAULT_CURRENCY=try
